{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "input_plan_digest", "decision_log_digest", "resolutions", "plan"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "input_plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision_log_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "outcome", "evidence"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["fixed", "not_reproduced", "needs_user_input", "disputed"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "previous_digest", "changed_sections"],
      "properties": {
        "content": {"type": "string", "minLength": 1},
        "previous_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "new_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_sections": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
