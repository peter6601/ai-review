{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "answer_digest", "plan"],
  "properties": {
    "summary": {"type": "string", "minLength": 1},
    "answer_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "previous_digest", "new_digest", "changed_sections"],
      "properties": {
        "content": {"type": "string", "minLength": 1},
        "previous_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "new_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "changed_sections": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
